# Nexcor — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ──────────────────────────────────
# Supabase (already set up from auth build)
# ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ──────────────────────────────────
# Site URL (used for Stripe redirects)
# ──────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production: NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ──────────────────────────────────
# Anthropic (Claude API)
# Get from: https://console.anthropic.com/settings/keys
# ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────
# Stripe
# Get from: https://dashboard.stripe.com/test/apikeys
# ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — get from: https://dashboard.stripe.com/test/webhooks
# Set endpoint: {YOUR_DOMAIN}/api/marks/webhook
# Listen for event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Mark Pack Stripe Price IDs
# Create 3 one-time products in Stripe, then paste the price IDs:
#   "Nexcor Marks Small"   500 Marks   $2.99
#   "Nexcor Marks Medium"  1200 Marks  $4.99
#   "Nexcor Marks Large"   3000 Marks  $11.99
STRIPE_PRICE_MARKS_SMALL=price_...
STRIPE_PRICE_MARKS_MEDIUM=price_...
STRIPE_PRICE_MARKS_LARGE=price_...

# Subscription webhook secret — SEPARATE from the marks webhook above
# Add a second webhook in Stripe Dashboard → Webhooks:
#   Endpoint URL: {YOUR_DOMAIN}/api/stripe/subscription-webhook
#   Events: checkout.session.completed, customer.subscription.updated,
#            customer.subscription.deleted, invoice.payment_succeeded
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...

# Brilliant Subscription Stripe Price IDs
# Create 3 recurring products in Stripe Dashboard → Products:
#   "Brilliant 2 Weeks"  — billing every 2 weeks
#   "Brilliant 1 Month"  — billing monthly
#   "Brilliant 2 Months" — billing every 2 months
STRIPE_PRICE_BRILLIANT_2WK=price_...
STRIPE_PRICE_BRILLIANT_1MO=price_...
STRIPE_PRICE_BRILLIANT_2MO=price_...
